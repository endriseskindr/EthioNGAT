<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".NigatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NigatEthiopia"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.chapters.ChaptersActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.home.HomeActivity" />

        <activity
            android:name=".ui.quiz.QuizActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.chapters.ChaptersActivity" />

        <activity
            android:name=".ui.vocabulary.VocabularyActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.home.HomeActivity" />

        <activity
            android:name=".ui.vocabulary.VocabDetailActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.vocabulary.VocabularyActivity" />

        <activity
            android:name=".ui.progress.ProgressActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.home.HomeActivity" />

        <activity
            android:name=".ui.detail.ResultActivity"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.quiz.QuizActivity" />

    </application>

</manifest>
